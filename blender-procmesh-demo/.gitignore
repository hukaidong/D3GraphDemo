# Blender projects, written after each render by render_demo.py.
# Regenerate with ./run.sh -- they are build output, not source.
example/
*.blend
*.blend1

# The committed renders in renders/ are checked in deliberately (the README
# links them); anything else Blender drops there is not.
renders/*.exr

# Python bytecode from local syntax checks
__pycache__/
*.pyc
